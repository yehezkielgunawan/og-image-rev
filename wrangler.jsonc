{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "og-image-rev",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-23",
  "routes": [
    {
      "pattern": "og-image-rev.yehezgun.com",
      "custom_domain": true,
    },
  ],
  "cache": {
    "enabled": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.ttf",
        "**/*.woff",
        "**/*.woff2",
        "**/*.ico",
        "**/*.svg",
        "**/*.png",
        "**/*.css",
      ],
      "fallthrough": true,
    },
  ],
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
