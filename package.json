{
  "name": "og-image-rev",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file=wrangler.typegen.env",
    "test": "vitest",
    "test:run": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "tsc -p test/tsconfig.json --noEmit",
    "up-latest": "pnpm up -i -L"
  },
  "dependencies": {
    "@takumi-rs/helpers": "^2.14.0",
    "@takumi-rs/wasm": "^2.14.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.3",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef"
}
